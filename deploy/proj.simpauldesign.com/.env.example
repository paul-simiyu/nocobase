# Deployment: proj.simpauldesign.com
#
# Copy to .env beside this file, fill in every value marked CHANGE ME, then
# `docker compose up -d`. Never commit the filled-in .env.

# --- Application ---------------------------------------------------------
APP_ENV=production
# The container listens on 80; compose maps it to this port on localhost only.
APP_PORT=13000

# CHANGE ME. Generate each independently: openssl rand -base64 32
# APP_KEY signs sessions. Rotating it logs everyone out.
APP_KEY=
# ENCRYPTION_FIELD_KEY encrypts encrypted-field values at rest. Rotating it
# makes existing encrypted values unreadable, so set it once and keep it.
ENCRYPTION_FIELD_KEY=

# Served from the same host, so the client can use a relative API path.
API_BASE_PATH=/api/
API_BASE_URL=

# --- Database ------------------------------------------------------------
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nocobase
DB_USER=nocobase
# CHANGE ME: openssl rand -base64 24
DB_PASSWORD=
# Must stay false. The CRM 2.0 solution fails to restore when it is true, and
# changing it after the first boot renames every column.
DB_UNDERSCORED=false

# --- Logging -------------------------------------------------------------
LOGGER_TRANSPORT=dailyRotateFile
LOGGER_LEVEL=info
LOGGER_MAX_FILES=14d

# --- Tender radar --------------------------------------------------------
# Token for the CRM the plugin sends leads to. The plugin reads this by NAME:
# put `TENDER_RADAR_CRM_TOKEN` in the crmTargets row's `tokenVariable` column,
# never the token itself, so a dump of that table carries no secret.
# CHANGE ME if you have configured a CRM target.
TENDER_RADAR_CRM_TOKEN=

# ReliefWeb asks re-users to identify themselves; required only if you enable
# that source. Any stable string identifying this deployment is fine.
TENDER_RADAR_RELIEFWEB_APPNAME=proj.simpauldesign.com
